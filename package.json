{
  "name": "evan-kit",
  "version": "1.0.0",
  "description": "Vue toolkit for Evan conference applications.",
  "author": "Eneko Illarramendi <eneko.illarramendi@ugent.be>",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "quasar",
    "evan",
    "conference",
    "components",
    "composables",
    "toolkit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eillarra/evan-kit.git"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "yarn@4.18.0",
  "main": "./dist/index.js",
  "bin": {
    "evan-archive": "./bin/archive.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "import": "./dist/types/types/index.js",
      "default": "./dist/types/types/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js",
      "default": "./dist/composables/*.js"
    },
    "./stores/*": {
      "types": "./dist/stores/*.d.ts",
      "import": "./dist/stores/*.js",
      "default": "./dist/stores/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.vue",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@types/markdown-it": "14.1.1",
    "date-fns": "^3.0.0",
    "date-fns-tz": "^3.2.0",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^5.0.0"
  },
  "peerDependencies": {
    "pinia": "^4.0.3",
    "quasar": "^2.26.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^20.12.0",
    "pinia": "^4.0.3",
    "quasar": "^2.28.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.11"
  }
}
